Fix_F_sub =
fun (A : Type) (R : A -> A -> Prop) (P : A -> Type)
  (F_sub : forall x : A, (forall y : {y : A | R y x}, P (proj1_sig y)) -> P x) =>
fix Fix_F_sub (x : A) (r : Acc R x) {struct r} : P x :=
  F_sub x
    (fun y : {y : A | R y x} =>
     Fix_F_sub (proj1_sig y) (Acc_inv r (proj2_sig y)))
     : forall (A : Type) (R : A -> A -> Prop) (P : A -> Type),
       (forall x : A, (forall y : {y : A | R y x}, P (proj1_sig y)) -> P x) ->
       forall x : A, Acc R x -> P x

