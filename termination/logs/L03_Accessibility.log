Acc_inv =
fun (A : Type) (R : A -> A -> Prop) (x : A) (H : Acc R x) =>
match H with
| Acc_intro _ x0 => (fun H0 : forall y : A, R y x -> Acc R y => H0) x0
end
     : forall [A : Type] [R : A -> A -> Prop] [x : A],
       Acc R x -> forall [y : A], R y x -> Acc R y

